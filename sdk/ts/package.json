{
  "name": "@common-agent/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Common Agent runtime — HTTP SSE streaming client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~6",
    "vite": "^8",
    "vite-plugin-dts": "^4",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github.com/teexue/common-agent",
    "directory": "sdk/ts"
  },
  "engines": {
    "node": ">=18"
  }
}
